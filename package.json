{
  "name": "explorador-web-estilos",
  "version": "0.1.0",
  "description": "Recorre un sitio web y produce un sistema de design tokens (DTCG).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "explorer": "src/cli/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "crawl": "tsx src/cli/index.ts crawl",
    "server": "tsx src/server/index.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
